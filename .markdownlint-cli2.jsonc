{
  "$schema": "./node_modules/markdownlint-cli2/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "code-block-style": {
      "style": "fenced"
    },
    "line-length": false,
    "no-emphasis-as-heading": true,
    "table-column-style": {
      "style": "compact"
    }
  },
  "gitignore": true,
  "globs": ["**/*.md"]
}
