{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/*.ts",
    "**/.*/**/*.ts",
    "**/.*.ts",
    "**/.*/**/.*.ts",
    "**/*.mts",
    "**/.*/**/*.mts",
    "**/.*.mts",
    "**/.*/**/.*.mts"
  ],
  "exclude": ["dist"]
}
