{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": [
    "**/*.mjs",
    "**/.*/**/*.mjs",
    "**/.*.mjs",
    "**/.*/**/.*.mjs",
    "**/*.ts",
    "**/.*/**/*.ts",
    "**/.*.ts",
    "**/.*/**/.*.ts",
    "**/*.mts",
    "**/.*/**/*.mts",
    "**/.*.mts",
    "**/.*/**/.*.mts"
  ],
  "exclude": ["dist"]
}
