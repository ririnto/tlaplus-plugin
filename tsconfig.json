{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.mts",
    "tests/**/*.mts"
  ]
}
