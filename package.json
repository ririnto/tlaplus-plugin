{
  "name": "@tlaplus-mcp/tlaplus-mcp",
  "version": "1.7.4-2026.11.19.1",
  "description": "Parse TLA+ specifications, check models with TLC, and read TLA+ modeling guidance.",
  "license": "MIT",
  "author": "ririnto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ririnto/tlaplus-plugin.git"
  },
  "bin": {
    "tlaplus-mcp": "dist/server.mjs"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "run-p check:*",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:test": "npm run test:consumer --",
    "check:typescript": "tsc",
    "check:ultracite": "ultracite check",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "ultracite fix",
    "prepack": "npm run build",
    "prepare": "husky",
    "test": "npm run check:typescript && npm run test:consumer --",
    "test:consumer": "node scripts/test-consumer.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "cross-spawn": "catalog:",
    "esbuild": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "optionalDependencies": {
    "@tlaplus-mcp/tlaplus-mcp-darwin-arm64": "1.7.4-2026.11.19.1",
    "@tlaplus-mcp/tlaplus-mcp-darwin-x64": "1.7.4-2026.11.19.1",
    "@tlaplus-mcp/tlaplus-mcp-linux-arm64": "1.7.4-2026.11.19.1",
    "@tlaplus-mcp/tlaplus-mcp-linux-x64": "1.7.4-2026.11.19.1",
    "@tlaplus-mcp/tlaplus-mcp-win32-x64": "1.7.4-2026.11.19.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.21.0"
}
