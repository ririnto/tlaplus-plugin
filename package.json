{
  "name": "@ririnto/tlaplus-plugin",
  "version": "1.7.4",
  "description": "TLA+ SANY and TLC tools over stdio MCP with official AgentSkills.",
  "license": "MIT",
  "author": "ririnto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ririnto/tlaplus-plugin.git"
  },
  "bin": {
    "tlaplus-plugin": "dist/server.mjs"
  },
  "files": [
    "dist/",
    "vendor/",
    "skills/",
    ".claude-plugin/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/assets.mts",
    "prepack": "pnpm build",
    "check": "run-s check:types check:ultracite check:markdown check:test",
    "check:types": "tsc --noEmit",
    "check:ultracite": "ultracite check --type-aware",
    "check:markdown": "markdownlint-cli2",
    "check:test": "node --test tests/*.test.mts",
    "check:integration": "node --test tests/integration/*.test.mts",
    "fix": "ultracite fix",
    "pre-commit": "pnpm check",
    "pre-push": "pnpm check && pnpm check:integration",
    "prepare": "husky",
    "check:pack": "node scripts/verify-pack.mts",
    "check:consumer": "node scripts/verify-consumer.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "packageManager": "pnpm@12.21.0",
  "tla2tools": "1.7.4"
}
